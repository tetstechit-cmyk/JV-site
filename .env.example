# === Banco: Neon (https://neon.tech) ===
# DATABASE_URL = "Pooled connection" (host com -pooler) — usado em runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL = conexão DIRETA (sem -pooler) — usada só nas migrations.
DIRECT_URL="postgresql://user:password@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# === URL pública do site (origem exata, SEM barra final) ===
# Em produção: https://seudominio.com.br . Usada no CSRF/CORS e no live preview.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# === Payload CMS ===
# Gere com: openssl rand -base64 32
PAYLOAD_SECRET=""

# === Cloudinary (armazenamento das imagens/vídeo) ===
# cloudinary.com > Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

